{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: compile",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["-DskipTests", "compile"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "backend: run",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["spring-boot:run"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "isBackground": true,
      "problemMatcher": ["$javac"]
    }
  ]
}
